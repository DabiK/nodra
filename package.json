{
  "name": "nodra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nodra": "scripts/nodra-cli.cjs"
  },
  "workspaces": [
    "packages/domain",
    "packages/application",
    "packages/adapters",
    "apps/api",
    "apps/cli",
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @nodra/api",
    "web": "npm run dev -w @nodra/web",
    "cli": "tsx apps/cli/src/main.ts",
    "start": "npm run start -w @nodra/api",
    "worker": "npm run start -w @nodra/worker",
    "typecheck": "tsc -p tsconfig.check.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "runtime:start": "tsx scripts/runtime/runtime-cli.ts start",
    "runtime:stop": "tsx scripts/runtime/runtime-cli.ts stop",
    "runtime:status": "tsx scripts/runtime/runtime-cli.ts status",
    "runtime:doctor": "tsx scripts/runtime/runtime-cli.ts doctor",
    "runtime:logs": "tsx scripts/runtime/runtime-cli.ts logs",
    "win:start": "powershell -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "win:start:web": "powershell -ExecutionPolicy Bypass -File scripts/windows/start.ps1 -Web",
    "win:stop": "powershell -ExecutionPolicy Bypass -File scripts/windows/stop.ps1",
    "runtime:windows:start": "npm run win:start:web",
    "runtime:windows:stop": "npm run win:stop",
    "temporal:dev": "tsx scripts/start-temporal-dev.ts",
    "temporal:health": "tsx scripts/diagnose-temporal.ts",
    "test:poc:temporal": "tsx poc/temporal/i6-2-poc.ts",
    "test:e2e:i7": "vitest run apps/api/i7-temporal.e2e.test.ts",
    "test:e2e:i7:codex": "cross-env NODRA_I7_PROVIDER=codex vitest run apps/api/i7-temporal.e2e.test.ts",
    "test:e2e:i8:opencode": "cross-env NODRA_I8_PROVIDER=opencode vitest run apps/api/i8-opencode.e2e.test.ts",
    "test:e2e:i8:deterministic": "cross-env NODRA_TEST_I8_DETERMINISTIC=1 vitest run apps/api/i7-temporal.e2e.test.ts",
    "test:e2e:i10:runtime": "cross-env NODRA_TEST_RUNTIME_I10=1 tsx poc/runtime/i10-runtime-e2e.ts",
    "codex:schema:export": "tsx scripts/export-codex-app-server-schema.ts",
    "opencode:schema:export": "tsx scripts/export-opencode-server-schema.ts",
    "db:generate": "drizzle-kit generate --config packages/adapters/drizzle.config.ts",
    "db:setup": "tsx packages/adapters/scripts/setup-database.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

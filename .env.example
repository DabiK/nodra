# Nodra environment variables (all optional — defaults shown).
# Node reads process.env directly; this file is NOT auto-loaded.
# Copy the lines you need into your shell profile or process manager.
#
# PowerShell:   $env:NODRA_DATABASE_FILE = "C:\path\to\nodra.db"
# cmd.exe:      set NODRA_DATABASE_FILE=C:\path\to\nodra.db
# bash/zsh:     export NODRA_DATABASE_FILE=/path/to/nodra.db

# --- Storage ---
# NODRA_DATABASE_FILE=data/nodra.db
# NODRA_DATA_ROOT=data/local
# NODRA_RUNTIME_ROOT=data/local/runtime
# NODRA_RUNTIME_PROFILE=user

# --- Temporal ---
# NODRA_TEMPORAL_ADDRESS=127.0.0.1:7233
# NODRA_TEMPORAL_NAMESPACE=nodra
# NODRA_TEMPORAL_BINARY=temporal        # explicit path if not on PATH

# --- OpenCode (agent provider) ---
# NODRA_OPENCODE_URL=http://127.0.0.1:4096
# NODRA_OPENCODE_BINARY=opencode        # explicit path if not on PATH
# NODRA_OPENCODE_EXECUTION_TIMEOUT_MS=300000

# --- API / runtime ---
# NODRA_API_URL=http://127.0.0.1:4100
# NODRA_RUNTIME_STOP_TIMEOUT_MS=5000
